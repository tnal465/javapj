<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>회원 수정 성공</title>
    <script>
        // 페이지 로드 후 alert 메시지 띄우고, 2초 후 회원 정보 페이지로 리다이렉트
        window.onload = function() {
            alert("회원 정보가 성공적으로 저장되었습니다!"); 
            setTimeout(function() {
                window.location.href = "/user/info"; // 회원 정보 페이지 URL로 리다이렉트
            }, 2000); // 2초 후 리다이렉트
        };
    </script>
</head>
<body>

    
</body>
</html>
