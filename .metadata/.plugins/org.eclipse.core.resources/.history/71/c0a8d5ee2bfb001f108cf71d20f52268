<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC
 "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
 <mapper namespace="member.repository.MemberDAO">
 <insert id="insert">
 insert into member(username,password,email,role,regdate) 
values(#{member.username}
,#{member.password}
,#{member.email}
,#{member.role}
,#{member.regdate})
 </insert>
 
 <select id="findAll" resultType="project.model.order">
 select * from orders
 </select>
 
 <select id="findById" resultType="member.model.Member">
 select * from member where username=#{username}
 </select>

 
 </mapper>